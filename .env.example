# Copy to .env and fill in. Never commit .env.

# ---- Core ----
# Public origin. Drives QR content and sign-in links. No trailing slash.
LOST_BASE_URL=https://lost.example.com
# REQUIRED: a long random string used to sign sessions. Generate with:
#   openssl rand -base64 48
LOST_SESSION_SECRET=

# From/reply identity on outbound mail.
LOST_FROM_ADDRESS=lost@example.com
LOST_FROM_NAME=Lost & Found

# ---- Datastore ----
# SQLite (default, zero-config):
LOST_DB_URL=sqlite:///data/lost.db
# Postgres (use with `--profile postgres`, or point at any Postgres):
# LOST_DB_URL=postgres://lost:lost@postgres:5432/lost?sslmode=disable
# POSTGRES_USER=lost
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=lost

# ---- Notifier: smtp | posterboy | gmail-api | sqs ----
LOST_NOTIFIER=smtp

# smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# posterboy — send to a Posterboy relay. mode=smtp talks SMTP to the relay; mode=http POSTs JSON.
POSTERBOY_MODE=smtp
POSTERBOY_HOST=posterboy
POSTERBOY_PORT=2525
# POSTERBOY_USERNAME=
# POSTERBOY_PASSWORD=
# POSTERBOY_INGEST_URL=

# gmail-api (mount credentials + a token minted via the OAuth flow)
GMAIL_CREDENTIALS_PATH=/data/gmail/credentials.json
GMAIL_TOKEN_PATH=/data/gmail/token.json
GMAIL_SENDER_ALIAS=

# sqs (a separate consumer performs the actual send; AWS creds via standard chain)
SQS_QUEUE_URL=
AWS_REGION=us-east-1

# ---- Registration & admin ----
# Cap the total number of registered users (0 = unlimited).
LOST_MAX_USERS=0
# Comma-separated admin emails. Admins are normal magic-link users whose email is
# listed here; they get the /app/admin panel (registered users + usage).
LOST_ADMIN_EMAILS=

# ---- IP geolocation (metadata collected on QR scan / found report) ----
# none (default) | ipapi (ip-api.com — no key, sends the IP to a third party) |
# maxmind (local GeoLite2 City DB — fully offline, privacy-preserving)
LOST_GEO_PROVIDER=none
# LOST_GEOIP_DB=/data/GeoLite2-City.mmdb   # required when LOST_GEO_PROVIDER=maxmind

# ---- Finder re-report throttle (a finder updating their message) ----
# LOST_FINDER_MIN_INTERVAL=2h   # minimum gap between a finder's submissions
# LOST_FINDER_DAILY_CAP=6       # max submissions per finder per rolling 24h

# ---- Optional bot deterrent on the public found form (Cloudflare Turnstile) ----
# LOST_TURNSTILE_SITE_KEY=
# LOST_TURNSTILE_SECRET=

# ---- Optional tuning ----
# LOST_MAGIC_LINK_TTL=15m
# LOST_SESSION_TTL=720h
